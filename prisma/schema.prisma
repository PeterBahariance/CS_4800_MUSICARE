// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define Prisma Client generator
generator client {
  provider = "prisma-client-js"
}

// File storage model for Musicare
model File {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  size      Int
  content   String   @db.Text
  section   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("musicare_files")
}

// People model for database demo
model People {
  id        Int    @id @default(autoincrement())
  firstName String @map("first_name")
  lastName  String @map("last_name")

  @@map("people")
}

// User model for Musicare - Music for Health & Wellness
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String?   @unique // Unique handle like @username
  displayName   String?   // Display name shown to others
  emailVerified Boolean   @default(false)
  
  // Health & Wellness preferences
  healthGoals   String[]  @default([]) // e.g., ["mental_wellness", "stress_relief", "sleep_improvement"]
  musicPreferences String[] @default([]) // Preferred genres
  dailyListeningGoal Int?  // Minutes per day goal
  
  // Metadata
  timezone      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}
