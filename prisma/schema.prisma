// Define database connection via the `DATABASE_URL` env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define Prisma Client generator
generator client {
  provider = "prisma-client-js"
}

// File storage model for Musicare
model File {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  size      Int
  content   String   @db.Text
  section   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("musicare_files")
}

// People model for database demo
model People {
  id        Int    @id @default(autoincrement())
  firstName String @map("first_name")
  lastName  String @map("last_name")

  @@map("people")
}

// User model for Musicare - Music for Health & Wellness
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  firebaseUid   String?   @unique // Firebase Authentication UID
  username      String?   @unique // Unique handle like @username
  displayName   String?   // Display name shown to others
  emailVerified Boolean   @default(false)

  // Health & Wellness preferences
  healthGoals   String[]  @default([]) // e.g., ["mental_wellness", "stress_relief", "sleep_improvement"]
  musicPreferences String[] @default([]) // Preferred genres
  dailyListeningGoal Int?  // Minutes per day goal

  // Metadata
  timezone      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Friend relationships
  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")
  friendsInitiated       Friend[]        @relation("FriendInitiator")
  friendsReceived        Friend[]        @relation("FriendReceiver")

  @@map("users")
}

// Friend relationship model
model Friend {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  friendId    String   @map("friend_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation("FriendInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend      User     @relation("FriendReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friends")
}

// Friend request model
model FriendRequest {
  id          String            @id @default(uuid())
  senderId    String            @map("sender_id")
  receiverId  String            @map("receiver_id")
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  sender      User              @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User              @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

// Friend request status enum
enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}
